{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OKF_v0.2_Schema",
  "type": "object",
  "required": ["okf_version", "id", "type", "title", "status", "created", "updated", "tags", "relations", "summary"],
  "properties": {
    "okf_version": {
      "type": "string",
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-_]+$"
    },
    "type": {
      "type": "string",
      "enum": ["concept", "procedure", "inquiry", "record", "covenant"]
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "frozen", "deprecated"]
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "ref"],
        "properties": {
          "rel": {
            "type": "string",
            "enum": ["depends_on", "implements", "rectifies", "validates", "cites"]
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    }
  },
  "additionalProperties": true
}